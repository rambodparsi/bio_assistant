# Copy this file to ".env" and fill in the values. NEVER commit .env.
# On Hugging Face Spaces, add the same names as Space "Secrets" instead.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hugging Face token: https://huggingface.co/settings/tokens
# - On your computer: a WRITE token (needed to upload to the private dataset).
# - On the Space: a READ token is enough.
HF_TOKEN=
